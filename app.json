{
  "expo": {
    "name": "Transit Scanner",
    "slug": "TrackTransit",
    "scheme": "transitscanner",
    "version": "1.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Transit Scanner uses your location to show your position on the map and track an active ride when you choose to start one.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Transit Scanner uses background location only during an active ride so it can send get-off alerts before your destination.",
        "NSLocationAlwaysUsageDescription": "Transit Scanner uses background location only during an active ride to provide get-off alert support.",
        "NSUserNotificationsUsageDescription": "Transit Scanner sends ride alerts and get-off reminders when you enable notifications.",
        "UIBackgroundModes": [
          "location"
        ],
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.harpreetmails.transitscanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.harpreetmails.transitscanner",
      "edgeToEdgeEnabled": true,
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/7ff38324-7f69-412d-8c64-b8d95f647183",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00853F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transit Scanner uses your location to show your position on the map and track an active ride when you choose to start one.",
          "locationAlwaysAndWhenInUsePermission": "Transit Scanner uses background location only during an active ride so it can send get-off alerts before your destination.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-live-activity"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ff38324-7f69-412d-8c64-b8d95f647183"
      }
    },
    "owner": "harpreetmailsexpo"
  }
}
